{
  "name": "testit-adapter-cypress",
  "version": "5.1.1",
  "description": "Cypress adapter for Test IT",
  "license": "Apache-2.0",
  "author": {
    "name": "Integration team",
    "email": "integrations@testit.software"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testit-tms/adapters-js.git"
  },
  "keywords": [],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./runtime": {
      "types": "./dist/browser/runtime.d.ts",
      "default": "./dist/browser/runtime.js"
    }
  },
  "scripts": {
    "clean": "rimraf ./dist ./out",
    "prebuild": "npm --prefix ../testit-js-commons run build && npm link ../testit-js-commons",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "cypress": "14.2.0",
    "typescript": "^5.2.2",
    "esbuild": "^0.27.0",
    "eslint": "^8.57.0",
    "@types/eslint": "^8.56.11",
    "@types/node": "^20.14.2"
  },
  "dependencies": {
    "testit-js-commons": "5.1.1"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "qs": "^6.17.1",
    "flatted": "^3.4.2",
    "js-yaml": "^4.3.2",
    "lodash": "^4.18.1",
    "picomatch": "^2.3.2",
    "tmp": "^0.2.6",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "browserslist": "^4.29.5"
  },
  "files": [
    "dist"
  ]
}
